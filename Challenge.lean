/-!
# Tensor PCA: statements of record

The definitions below specify the concrete tensor experiment and scalar
variational quantities used by the advertised results. Positive dimensions are
enumerated by n+1; constrained expected limits start at dimension n+2. The
physical sequence permits arbitrary coupling across dimensions. Estimator
randomness is independent of the experiment within each dimension.

The compared declarations cover all twelve principal exports. Their statements
specify the tensor-order, strength and overlap domains. References below name
both the maintainer's local revision and the public arXiv v2 counterpart. The four-parameter
result is equality of numerical infima, without a minimizer-attainment claim.
The definitions are repeated under the same qualified names as the proof
library so that Challenge and Solution can be compared in separate environments.
Only the final theorem bodies are deliberate statement holes.
-/

@[expose] public section

namespace TensorPCA.Model

open MeasureTheory ProbabilityTheory Set
open scoped BigOperators RealInnerProductSpace

/-- Physical vectors with the Euclidean norm. -/
abbrev Vector (N : ℕ) := EuclideanSpace ℝ (Fin N)

/-- All ordered tensor coordinates, with the Euclidean/Frobenius norm. -/
abbrev Tensor (N k : ℕ) := EuclideanSpace ℝ (Fin k → Fin N)

/-- The coordinate tensor product, with the empty-product convention. -/
noncomputable def feature {N : ℕ} (k : ℕ) (x : Vector N) : Tensor N k :=
  WithLp.toLp 2 (fun i ↦ ∏ j, x (i j))

/-- The unit sphere in the ambient Euclidean vector space. -/
def unitSphere (N : ℕ) : Set (Vector N) := {x | ‖x‖ = 1}

/-- Radial normalization, with value zero at the origin. -/
noncomputable def normalize {N : ℕ} (x : Vector N) : Vector N := ‖x‖⁻¹ • x

/-- The radial image of standard Gaussian measure; uniform on the sphere in positive dimension. -/
noncomputable def spherePrior (N : ℕ) : Measure (Vector N) :=
  (stdGaussian (Vector N)).map normalize

/-- Independent standard Gaussian tensor coordinates. -/
noncomputable def noiseLaw (N k : ℕ) : Measure (Tensor N k) :=
  stdGaussian (Tensor N k)

/-- The product law of the planted unit vector and Gaussian tensor noise. -/
noncomputable def experimentLaw (N k : ℕ) : Measure (Vector N × Tensor N k) :=
  (spherePrior N).prod (noiseLaw N k)

/-- The observation Y = lam * sqrt(N) * feature(k,x) + w. -/
noncomputable def observation {N k : ℕ} (lam : ℝ)
    (z : Vector N × Tensor N k) : Tensor N k :=
  (lam * Real.sqrt N) • feature k z.1 + z.2

/-- The observed tensor law at the given strength; strength zero is the null law. -/
noncomputable def observationLaw (N k : ℕ) (lam : ℝ) : Measure (Tensor N k) :=
  (experimentLaw N k).map (observation lam)

/-- Probability-normalized total variation: half of Mathlib's `tvDist`. -/
noncomputable def testingDistance (N k : ℕ) (lam : ℝ) : ℝ :=
  MeasureTheory.tvDist (observationLaw N k 0) (observationLaw N k lam) / 2

/-- The unnormalized likelihood objective, the feature/observation inner product. -/
noncomputable def score {N k : ℕ} (y : Tensor N k) (x : Vector N) : ℝ :=
  inner ℝ (feature k x) y

/-- The supremum of the score on the unit sphere, divided by sqrt(N). -/
noncomputable def normalizedMaximum {N k : ℕ} (y : Tensor N k) : ℝ :=
  sSup (score y '' unitSphere N) / Real.sqrt N

/-- The normalized planted maximum at the fixed signed overlap m. -/
noncomputable def constrainedMaximum {N k : ℕ} (lam : ℝ)
    (x : Vector N) (w : Tensor N k) (m : ℝ) : ℝ :=
  sSup ((fun v ↦ lam * m ^ k + score w v / Real.sqrt N) ''
    {v ∈ unitSphere N | inner ℝ v x = m})

/-- The sub-sigma-algebra generated by the observed tensor. -/
@[instance_reducible] noncomputable def observedSigma (N k : ℕ) (lam : ℝ) : MeasurableSpace (Vector N × Tensor N k) :=
  MeasurableSpace.comap (observation lam) (inferInstance : MeasurableSpace (Tensor N k))

/-- The conditional mean of the planted tensor feature given the observation. -/
noncomputable def posteriorTensor (N k : ℕ) (lam : ℝ) :
    Vector N × Tensor N k → Tensor N k :=
  MeasureTheory.condExp (observedSigma N k lam) (experimentLaw N k)
    (fun z ↦ feature k z.1)

/-- Expected squared Frobenius loss of the posterior conditional mean. -/
noncomputable def tensorMMSE (N k : ℕ) (lam : ℝ) : ℝ :=
  ∫ z, ‖feature k z.1 - posteriorTensor N k lam z‖ ^ 2 ∂experimentLaw N k

/-- A vector estimator using the observation and an independent auxiliary input. -/
abbrev Estimator (N k : ℕ) (A : Type*) := Tensor N k → A → Vector N

/-- Joint Borel measurability and unit norm at every input. -/
def IsUnitEstimator {N k : ℕ} {A : Type*} [MeasurableSpace A]
    (est : Estimator N k A) : Prop :=
  Measurable (Function.uncurry est) ∧ ∀ y a, ‖est y a‖ = 1

/-- A unit estimator that maximizes the likelihood score almost surely. -/
def IsMLE (N k : ℕ) (lam : ℝ) {A : Type*} [MeasurableSpace A]
    (est : Estimator N k A) (ν : Measure A) : Prop :=
  IsUnitEstimator est ∧
    ∀ᵐ z ∂(observationLaw N k lam).prod ν,
      ∀ x ∈ unitSphere N, score z.1 x ≤ score z.1 (est z.1 z.2)

/-- Expected absolute overlap to the indicated power under independent auxiliary randomness. -/
noncomputable def expectedOverlapPower (N k : ℕ) (lam : ℝ) {A : Type*}
    [MeasurableSpace A] (est : Estimator N k A) (ν : Measure A) (p : ℕ) : ℝ :=
  ∫ z, |inner ℝ (est (observation lam z.1) z.2) z.1.1| ^ p
    ∂(experimentLaw N k).prod ν

end TensorPCA.Model

namespace TensorPCA.Scalar

open Set MeasureTheory

noncomputable section

/-- Closed numeral witness shared by the scalar definitions. Naming it explicitly
keeps their elaborated proof arguments identical to the separate Scalar module. -/
lemma lambdaS._proof_1 : Nat.AtLeastTwo (1 + 1) :=
  @Nat.instAtLeastTwoHAddOfNat 1 (@Nat.instNeZeroSucc 0)

attribute [local instance] lambdaS._proof_1

/-- The scalar potential on the interval [0,1). -/
def f (k : ℕ) (lam q : ℝ) : ℝ :=
  lam ^ 2 * q ^ k + Real.log (1 - q) + q

/-- The nonnegative-strength detection threshold, defined by nonpositivity of f on [0,1). -/
def lambdaC (k : ℕ) : ℝ :=
  sSup {lam : ℝ | 0 ≤ lam ∧ ∀ q ∈ Ico (0 : ℝ) 1, f k lam q ≤ 0}

/-- The secondary-branch threshold, used for tensor order k at least three. -/
def lambdaS (k : ℕ) : ℝ :=
  Real.sqrt ((((k : ℝ) - 1) ^ (k - 1)) /
    ((k : ℝ) * ((k : ℝ) - 2) ^ (k - 2)))

/-- The stationary-point equation on the larger positive branch. -/
def StableStationaryPoint (k : ℕ) (lam q : ℝ) : Prop :=
  q ∈ Ioo (((k : ℝ) - 2) / ((k : ℝ) - 1)) 1 ∧
    (k : ℝ) * lam ^ 2 * q ^ (k - 2) * (1 - q) = 1

/-- The supremum of the larger-branch stationary-point set. -/
def qS (k : ℕ) (lam : ℝ) : ℝ :=
  sSup {q : ℝ | StableStationaryPoint k lam q}

/-- A global maximizer of f on its domain [0,1). -/
def IsScalarMaximizer (k : ℕ) (lam q : ℝ) : Prop :=
  q ∈ Ico (0 : ℝ) 1 ∧ ∀ r ∈ Ico (0 : ℝ) 1, f k lam r ≤ f k lam q

/-- The scalar maximizer, with value zero throughout the closed subcritical range. -/
def qStar (k : ℕ) (lam : ℝ) : ℝ :=
  if lam ≤ lambdaC k then 0 else sSup {q : ℝ | IsScalarMaximizer k lam q}

/-- The scalar root equation on strictly positive arguments. -/
def varphi (k : ℕ) (z : ℝ) : ℝ :=
  (1 + z) / z ^ 2 * Real.log (1 + z) - 1 / z - 1 / (k : ℝ)

/-- The infimum of the positive roots of varphi. -/
def zK (k : ℕ) : ℝ :=
  sInf {z : ℝ | 0 < z ∧ varphi k z = 0}

/-- The pure-model ground-state constant determined by zK. -/
def gs (k : ℕ) : ℝ :=
  Real.sqrt (k : ℝ) / Real.sqrt (1 + zK k) * (1 + zK k / (k : ℝ))

/-- The supercritical maximum-likelihood value in terms of the scalar maximizer. -/
def supercriticalValue (k : ℕ) (lam : ℝ) : ℝ :=
  Real.sqrt (k : ℝ) * (1 + lam ^ 2 * (qStar k lam) ^ (k - 1)) /
    Real.sqrt (1 + lam ^ 2 * (k : ℝ) * (qStar k lam) ^ (k - 1))

/-- The limiting maximum-likelihood value, including its critical endpoint. -/
def mleValue (k : ℕ) (lam : ℝ) : ℝ :=
  if lam ≤ lambdaC k then gs k else supercriticalValue k lam

/-- The slice covariance, including the constant subtraction and linear term. -/
def xiSlice (k : ℕ) (m t : ℝ) : ℝ :=
  (m ^ 2 + (1 - m ^ 2) * t) ^ k - m ^ (2 * k)

/-- Continuous, antitone, concave, strictly positive profiles on [0,1]. -/
def AdmissibleProfile (p : ℝ → ℝ) : Prop :=
  ContinuousOn p (Icc (0 : ℝ) 1) ∧
  AntitoneOn p (Icc (0 : ℝ) 1) ∧
  ConcaveOn ℝ (Icc (0 : ℝ) 1) p ∧
  ∀ t ∈ Icc (0 : ℝ) 1, 0 < p t

/-- The ground-state profile functional, including its boundary coefficient. -/
def parisiFunctional (xi : ℝ → ℝ) (h : ℝ) (p : ℝ → ℝ) : ℝ :=
  (∫ t in (0 : ℝ)..1, deriv (deriv xi) t * p t + 1 / p t) +
    (h ^ 2 + deriv xi 0) * p 0

/-- Half the infimum over all admissible profiles; no minimizer is selected. -/
def variationalValue (xi : ℝ → ℝ) (h : ℝ) : ℝ :=
  (1 / 2 : ℝ) * sInf {v : ℝ | ∃ p : ℝ → ℝ,
    AdmissibleProfile p ∧ v = parisiFunctional xi h p}

/-- The constrained ground-state variational expression at the signed overlap m. -/
def energy (k : ℕ) (lam m : ℝ) : ℝ :=
  lam * m ^ k + variationalValue (xiSlice k m) 0

/-- The closed replica-symmetric energy on its stated overlap range. -/
def rsEnergy (k : ℕ) (lam m : ℝ) : ℝ :=
  lam * m ^ k + Real.sqrt ((k : ℝ) * (1 - m ^ 2))

/-- The profile family in local Remark 5.11 (arXiv v2: Remark 5.10). -/
def fourParameterProfile (delta a b q t : ℝ) : ℝ :=
  delta + a * (1 - t) + b * (1 - max t q)

/-- Positive delta, nonnegative a and b, and q in [0,1]. -/
def FourParameterAdmissible (delta a b q : ℝ) : Prop :=
  0 < delta ∧ 0 ≤ a ∧ 0 ≤ b ∧ q ∈ Icc (0 : ℝ) 1

/-- Half the infimum of the same functional over the four-parameter family. -/
def fourParameterValue (xi : ℝ → ℝ) (h : ℝ) : ℝ :=
  (1 / 2 : ℝ) * sInf {v : ℝ | ∃ delta a b q : ℝ,
    FourParameterAdmissible delta a b q ∧
      v = parisiFunctional xi h (fourParameterProfile delta a b q)}

/-- Equality of unrestricted and four-parameter numerical infima; no attainment is asserted. -/
def FourParameterReduction (k : ℕ) (m : ℝ) : Prop :=
  variationalValue (xiSlice k m) 0 = fourParameterValue (xiSlice k m) 0

end

end TensorPCA.Scalar

namespace TensorPCA.Statements

open MeasureTheory ProbabilityTheory Filter Set
open scoped Topology RealInnerProductSpace
universe u v

/-- Arbitrarily coupled positive-dimensional experiments with the exact independent signal/noise law within each dimension. -/
structure PhysicalSequence (k : ℕ) (Ω : Type u) [MeasurableSpace Ω] (μ : Measure Ω) where
  sample : (n : ℕ) → Ω → Model.Vector (n+1) × Model.Tensor (n+1) k
  measurable : ∀ n, Measurable (sample n)
  law : ∀ n, μ.map (sample n) = Model.experimentLaw (n+1) k

/-- Measurable unit estimators with independent auxiliary randomness within each dimension. -/
structure EstimatorCoupling {k : ℕ} {Ω : Type u} [MeasurableSpace Ω]
    {μ : Measure Ω} (E : PhysicalSequence k Ω μ)
    (A : ℕ → Type v) [∀ n, MeasurableSpace (A n)] (ν : ∀ n, Measure (A n)) where
  estimator : ∀ n, Model.Estimator (n+1) k (A n)
  unit : ∀ n, Model.IsUnitEstimator (estimator n)
  auxiliary : ∀ n, Ω → A n
  measurable : ∀ n, Measurable (auxiliary n)
  independentLaw : ∀ n, μ.map (fun ω ↦ (E.sample n ω, auxiliary n ω)) =
    (Model.experimentLaw (n+1) k).prod (ν n)

/-- The normalized maximum along a physical sequence. -/
noncomputable def sampleMaximum {k : ℕ} {Ω : Type u} [MeasurableSpace Ω]
    {μ : Measure Ω} (E : PhysicalSequence k Ω μ) (lam : ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  Model.normalizedMaximum (Model.observation lam (E.sample n ω))

/-- Closed numeral witness matching the independently compiled statement module. -/
lemma sampleOverlap._proof_1 : Nat.AtLeastTwo (1 + 1) :=
  @Nat.instAtLeastTwoHAddOfNat 1 (@Nat.instNeZeroSucc 0)

attribute [local instance] sampleOverlap._proof_1

/-- The absolute planted overlap of an independently randomized estimator.
The canonical Euclidean instance is explicit to keep its numeral witness stable. -/
noncomputable def sampleOverlap {k : ℕ} {Ω : Type u} [MeasurableSpace Ω]
    {μ : Measure Ω} {E : PhysicalSequence k Ω μ} {A : ℕ → Type v}
    [∀ n, MeasurableSpace (A n)] {ν : ∀ n, Measure (A n)}
    (R : EstimatorCoupling E A ν) (lam : ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  |@Inner.inner ℝ (Model.Vector (n+1))
    (@InnerProductSpace.toInner ℝ (Model.Vector (n+1)) Real.instRCLike
      (@PiLp.seminormedAddCommGroup (2 : ENNReal) (Fin (n+1)) (fun _ => ℝ)
        fact_one_le_two_ennreal (Fin.fintype (n+1))
        (fun _ => @NormedAddCommGroup.toSeminormedAddCommGroup ℝ Real.normedAddCommGroup))
      (@PiLp.innerProductSpace ℝ Real.instRCLike (Fin (n+1)) (Fin.fintype (n+1))
        (fun _ => ℝ) (fun _ => Real.normedAddCommGroup)
        (fun _ => @RCLike.toInnerProductSpaceReal ℝ Real.instRCLike)))
    (R.estimator n (Model.observation lam (E.sample n ω))
      (R.auxiliary n ω)) (E.sample n ω).1|

/-- Likelihood maximization and the symmetric-sign convention for even tensor order. -/
def IsPaperMLE {k : ℕ} {Ω : Type u} [MeasurableSpace Ω]
    {μ : Measure Ω} {E : PhysicalSequence k Ω μ} {A : ℕ → Type v}
    [∀ n, MeasurableSpace (A n)] {ν : ∀ n, Measure (A n)}
    (R : EstimatorCoupling E A ν) (lam : ℝ) : Prop :=
  (∀ n, Model.IsMLE (n+1) k lam (R.estimator n) (ν n)) ∧
    (Even k → ∀ n, ∀ᵐ y ∂Model.observationLaw (n+1) k lam,
      (ν n).map (R.estimator n y) = (ν n).map (fun a ↦ -R.estimator n y a))

/-- The exact detection transition for even k at least six; critical strength is excluded. -/
def Detection : Prop :=
  ∀ k : ℕ, 6 ≤ k → Even k → ∀ lam : ℝ, 0 ≤ lam →
    (lam < Scalar.lambdaC k → Tendsto (fun n ↦ Model.testingDistance (n+1) k lam)
      atTop (𝓝 0)) ∧
    (Scalar.lambdaC k < lam → Tendsto (fun n ↦ Model.testingDistance (n+1) k lam)
      atTop (𝓝 1))

/-- Almost-sure maximum-likelihood value for k at least three, including critical strength. -/
def MLEValue : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 ≤ lam →
    ∀ (Ω : Type u) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
      (E : PhysicalSequence k Ω μ),
      ∀ᵐ ω ∂μ, Tendsto (fun n ↦ sampleMaximum E lam n ω)
        atTop (𝓝 (Scalar.mleValue k lam))

/-- Almost-sure absolute MLE overlap, including zero strength and excluding critical strength. -/
def MLEOverlap : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 ≤ lam → lam ≠ Scalar.lambdaC k →
    ∀ (Ω : Type u) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
      (E : PhysicalSequence k Ω μ)
      (A : ℕ → Type v) [∀ n, MeasurableSpace (A n)]
      (ν : ∀ n, Measure (A n)) [∀ n, IsProbabilityMeasure (ν n)]
      (R : EstimatorCoupling E A ν), IsPaperMLE R lam →
        ∀ᵐ ω ∂μ, Tendsto (fun n ↦ sampleOverlap R lam n ω)
          atTop (𝓝 (Real.sqrt (Scalar.qStar k lam)))

/-- Local Proposition 5.9 (arXiv v2: Proposition 5.8): posterior tensor loss
at positive noncritical strength. -/
def TensorMMSE : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 < lam → lam ≠ Scalar.lambdaC k →
    Tendsto (fun n ↦ Model.tensorMMSE (n+1) k lam)
      atTop (𝓝 (1 - Scalar.qStar k lam ^ k))

/-- Local Corollary 5.10 (arXiv v2: Corollary 5.9), in the local
absolute-overlap formulation for independently randomized unit estimators. -/
def EstimatorOptimality : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 ≤ lam → lam ≠ Scalar.lambdaC k →
    ∀ (A : ℕ → Type v) [∀ n, MeasurableSpace (A n)]
      (ν : ∀ n, Measure (A n)) [∀ n, IsProbabilityMeasure (ν n)]
      (est : ∀ n, Model.Estimator (n+1) k (A n)),
      (∀ n, Model.IsUnitEstimator (est n)) →
      Filter.limsup (fun n ↦ Model.expectedOverlapPower (n+1) k lam (est n) (ν n) k)
        atTop ≤ (Real.sqrt (Scalar.qStar k lam)) ^ k ∧
      Filter.limsup (fun n ↦ Model.expectedOverlapPower (n+1) k lam (est n) (ν n) 1)
        atTop ≤ Real.sqrt (Scalar.qStar k lam)

/-- The unnumbered expected-absolute-overlap attainment consequence of
Theorem 1.2 and local Corollary 5.10 (arXiv v2: Corollary 5.9). -/
def MLEAttainment : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 ≤ lam → lam ≠ Scalar.lambdaC k →
    ∀ (Ω : Type u) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
      (E : PhysicalSequence k Ω μ)
      (A : ℕ → Type v) [∀ n, MeasurableSpace (A n)]
      (ν : ∀ n, Measure (A n)) [∀ n, IsProbabilityMeasure (ν n)]
      (R : EstimatorCoupling E A ν), IsPaperMLE R lam →
        Tendsto (fun n ↦ Model.expectedOverlapPower (n+1) k lam
          (R.estimator n) (ν n) 1) atTop (𝓝 (Real.sqrt (Scalar.qStar k lam)))

/-- Strict local maximality relative to the physical overlap interval [-1,1]. -/
def StrictLocalMaximumOn (f : ℝ → ℝ) (x : ℝ) : Prop :=
  x ∈ Icc (-1 : ℝ) 1 ∧ ∃ eps : ℝ, 0 < eps ∧
    ∀ y ∈ Icc (-1 : ℝ) 1, y ≠ x → |y-x| < eps → f y < f x

/-- Strict secondary local maximality, the exact globality threshold, and zero globality in the closed subcritical range. -/
def Landscape : Prop :=
  ∀ k : ℕ, 3 ≤ k →
    (∀ lam : ℝ, Scalar.lambdaS k < lam →
      StrictLocalMaximumOn (Scalar.energy k lam) (Real.sqrt (Scalar.qS k lam)) ∧
      ((∀ m ∈ Icc (-1 : ℝ) 1, Scalar.energy k lam m ≤
        Scalar.energy k lam (Real.sqrt (Scalar.qS k lam))) ↔ Scalar.lambdaC k ≤ lam)) ∧
    (∀ lam : ℝ, 0 ≤ lam → lam ≤ Scalar.lambdaC k →
      ∀ m ∈ Icc (-1 : ℝ) 1, Scalar.energy k lam m ≤ Scalar.energy k lam 0)

/-- Local Lemma 5.5 (arXiv v2: Lemma 5.4): expected and almost-sure constrained
limits for signed overlaps and arbitrary coupling in dimension. -/
def ConstrainedLimit : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ lam : ℝ, 0 ≤ lam → ∀ m ∈ Icc (-1 : ℝ) 1,
    (Tendsto (fun n ↦ ∫ z, Model.constrainedMaximum lam z.1 z.2 m
      ∂Model.experimentLaw (n+2) k) atTop (𝓝 (Scalar.energy k lam m))) ∧
    (∀ (Ω : Type u) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
      (E : PhysicalSequence k Ω μ),
      ∀ᵐ ω ∂μ, Tendsto (fun n ↦ Model.constrainedMaximum lam
        (E.sample (n+1) ω).1 (E.sample (n+1) ω).2 m)
        atTop (𝓝 (Scalar.energy k lam m)))

/-- Local Lemma 5.6 and Remark 5.11 (arXiv v2: Lemma 5.5 and Remark 5.10):
the replica-symmetric evaluation and equality of variational infima. -/
def VariationalConclusions : Prop :=
  ∀ k : ℕ, 3 ≤ k →
    (∀ lam : ℝ, 0 ≤ lam → ∀ m ∈ Icc (-1 : ℝ) 1,
      Real.sqrt (1 - 1 / ((k : ℝ)-1)) ≤ |m| →
      Scalar.energy k lam m = Scalar.rsEnergy k lam m) ∧
    (∀ m : ℝ, |m| < 1 → Scalar.FourParameterReduction k m)

/-- The unnumbered introductory testing consequence for each fixed nonempty
finite family of distinct supercritical strengths. -/
def FiniteStrengthTesting : Prop :=
  ∀ k : ℕ, 3 ≤ k → ∀ r : ℕ, ∀ strengths : Fin (r+1) → ℝ,
    Function.Injective strengths → (∀ i, Scalar.lambdaC k < strengths i) →
    ∃ tests : ∀ n : ℕ, Model.Tensor (n+1) k → Fin (r+1),
      (∀ n, Measurable (tests n)) ∧ ∀ i,
      Tendsto (fun n ↦ (Model.observationLaw (n+1) k (strengths i)).real
        {y | tests n y ≠ i}) atTop (𝓝 0)

/-- Threshold separation and discontinuity of the selected overlap branch,
an unnumbered consequence of Theorem 1.2 in both versions. -/
def DiscontinuousTransition : Prop :=
  ∀ k : ℕ, 3 ≤ k → Scalar.lambdaS k < Scalar.lambdaC k ∧
    ((k : ℝ)-2)/((k : ℝ)-1) < Scalar.qS k (Scalar.lambdaC k) ∧
    (∀ lam : ℝ, 0 ≤ lam → lam < Scalar.lambdaC k → Scalar.qStar k lam = 0) ∧
    ¬ ContinuousAt (Scalar.qStar k) (Scalar.lambdaC k)

end TensorPCA.Statements

